@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Dan bo cuc trang web - layout </title>
    <style type="text/css">
            body {
                background-color: greenyellow;
                font-family: 'Times New Roman', Times, serif;
            }

            .container {
                border: 5px solid black;
                width: 90%;
                background-color: gray;
                margin: 20px auto;
                overflow: hidden;
            }

            .banner {
                background-color: lightgrey;
                height: 100px;
            }

            .navigator, .footer {
                background-color: dimgray;
                height: 40px;
            }

            .navigator {
                text-align: left;
            }

            .sidebar {
                background-color: gray;
                min-height: 450px;
                display: block;
                text-align: left;
                float: left;
                width: 20%;
            }

            .content {
                background-color: azure;
                width: 80%;
                min-height: 450px;
                float: left;
                padding-top: 5px;
            }

            .footer {
                text-align: center;
                clear: both;
            }

            .divider {
                clear: both;
                height: 5px;
                background-color: black;
            }
    </style>

</head>
<body>
    <div class="container">
        <div class="banner">BANNER</div>
        <div class="divider"></div>
        <div class="navigator">NAVIGATOR</div>
        <div class="divider"></div>
        <div class="sidebar">SIDEBAR</div>
        <div class="content">CONTENT</div>
        <div class="divider"></div>
        <div class="footer">FOOTER</div>
    </div>
</body>
</html>