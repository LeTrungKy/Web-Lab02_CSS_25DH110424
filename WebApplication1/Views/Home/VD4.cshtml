@{
    Layout = null;
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Tao thanh navigator</title>
    <style>
        #menu a:link, #menu a:visited {
            position: relative;
            display: block;
            text-align: center;
            color:white;
            text-decoration: none;
            padding: 10px;
            margin: 10px;
            background-color: gray;
            width: 100px;
            border: 3px solid black;
            border-color: red darkred deepskyblue darkblue;

        }
        #menu a:link{
            color: white;

        }
        #menu a:visited{
            color: darkblue;
        }
        #menu a:hover{
            color:red;
            top: 5px;
            left: 5px;
            right: 5px;
            bottom: 5px;
            background-color:yellow;
        }
    </style>
</head>
<body>
    <div id="menu">
        <a href="#">Home</a>
        <a href="#">About</a>
        <a href="#">History</a>
        <a href="#">Team</a>
        <a href="#">Office</a>
    </div>
</body>
</html>
